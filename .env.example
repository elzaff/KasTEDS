# Server-only values. Never put service-role keys in index.html.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
KASTEDS_AGENT_API_KEY=replace-with-a-long-random-key
KASTEDS_AGENT_ACTOR_ID=admin-profile-uuid
KASTEDS_TIMEZONE=Asia/Jakarta

# Optional browser CORS origin for an agent tool running in a browser.
# KASTEDS_AGENT_ORIGIN=https://your-agent.example.com

# Optional Meta WhatsApp Cloud API adapter.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_GRAPH_VERSION=v20.0
META_APP_SECRET=your-meta-app-secret
WHATSAPP_ALLOWED_NUMBERS=6281234567890

# Your agent/webhook endpoint. It receives { from, text, message_id } and returns { reply }.
KASTEDS_AGENT_WEBHOOK_URL=https://your-agent.example.com/webhooks/kasteds
KASTEDS_AGENT_WEBHOOK_SECRET=shared-secret-with-your-agent
