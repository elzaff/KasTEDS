{
  "openapi": "3.0.3",
  "info": {
    "title": "KasTEDS Agent API",
    "version": "1.0.0",
    "description": "Read communal cash summaries and create transactions or month-scoped budgets."
  },
  "servers": [{ "url": "https://kasteds.vercel.app" }],
  "components": {
    "securitySchemes": {
      "agentKey": { "type": "http", "scheme": "bearer", "description": "KASTEDS_AGENT_API_KEY" }
    },
    "schemas": {
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["INCOME", "EXPENSE"] },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "description": { "type": "string" }
        }
      },
      "AddTransaction": {
        "type": "object",
        "required": ["action", "type", "amount", "title"],
        "properties": {
          "action": { "type": "string", "enum": ["add_transaction"] },
          "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
          "type": { "type": "string", "enum": ["INCOME", "EXPENSE"] },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "description": { "type": "string" },
          "idempotency_key": { "type": "string" }
        }
      },
      "SetBudget": {
        "type": "object",
        "required": ["action", "month", "items"],
        "properties": {
          "action": { "type": "string", "enum": ["set_budget"] },
          "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "amount"],
              "properties": { "name": { "type": "string" }, "amount": { "type": "number", "minimum": 0 } }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/agent": {
      "get": {
        "summary": "Read a month-scoped summary, transactions, or budget",
        "security": [{ "agentKey": [] }],
        "parameters": [
          { "name": "view", "in": "query", "schema": { "type": "string", "enum": ["summary", "transactions", "budget"], "default": "summary" } },
          { "name": "month", "in": "query", "schema": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["ALL", "INCOME", "EXPENSE"] } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": { "200": { "description": "Success" }, "401": { "description": "Invalid API key" }, "503": { "description": "Missing server configuration" } }
      },
      "post": {
        "summary": "Add a transaction or save a month-scoped budget",
        "security": [{ "agentKey": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "oneOf": [{ "$ref": "#/components/schemas/AddTransaction" }, { "$ref": "#/components/schemas/SetBudget" }] }
            }
          }
        },
        "responses": { "201": { "description": "Transaction created" }, "200": { "description": "Budget saved or duplicate transaction" }, "422": { "description": "Validation error" }, "503": { "description": "Schema migration required" } }
      }
    },
    "/api/health": {
      "get": { "summary": "Check API configuration", "responses": { "200": { "description": "Configured" }, "503": { "description": "Not configured" } } }
    },
    "/api/whatsapp": {
      "get": { "summary": "Meta WhatsApp webhook verification", "responses": { "200": { "description": "Challenge accepted" } } },
      "post": { "summary": "Receive Meta WhatsApp webhook events", "responses": { "200": { "description": "Event received" } } }
    }
  }
}
